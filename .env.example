# =============================================================================
# Variables de entorno del panel admin de Celtas
# Copia este archivo a `.env` y ajusta los valores según tu entorno.
# =============================================================================

# URL base del backend NestJS.
#
# Producción (default):
VITE_API_BASE_URL=https://backend-celtas.onrender.com
#
# Desarrollo contra el backend local (Docker):
#   VITE_API_BASE_URL=http://localhost:3000
#
# Ojo: el backend local debe estar corriendo (docker compose up) y, si el
# frontend corre en otro puerto, revisar CORS en el backend.

# API key de Geoapify (Static Maps API), plan gratis: https://myprojects.geoapify.com/.
# Es la MISMA key que ya usa celtas-mobile (Geoapify permite una sola key para las
# 4 APIs: Autocomplete + Geocoding + Reverse Geocoding + Map Tiles/Static Maps) —
# no generar una key nueva, reusar la existente.
VITE_GEOAPIFY_API_KEY=tu_api_key_de_geoapify

# Config de Firebase Web (notificaciones push del admin — PATCH /users/me/fcm-token).
# Es el MISMO proyecto Firebase que ya usa celtas-mobile ("celtas-b0bd5"), tomado
# de lib/firebase_options.dart (bloque `web`) de ese repo — no crear un proyecto
# nuevo. Estos valores NO son secretos (Firebase los expone a propósito en el
# cliente web), así que van con su valor real de una — a diferencia de
# VITE_GEOAPIFY_API_KEY no hace falta generar nada para estos 6.
VITE_FIREBASE_API_KEY=AIzaSyBsWkn8S_InHiF4Loy-SBkljvsMi9kUAbg
VITE_FIREBASE_AUTH_DOMAIN=celtas-b0bd5.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=celtas-b0bd5
VITE_FIREBASE_STORAGE_BUCKET=celtas-b0bd5.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=614499893538
VITE_FIREBASE_APP_ID=1:614499893538:web:4ae7017138e62a2fa3657b

# VAPID key (certificado push web) — este SÍ hay que generarlo/copiarlo a mano:
# Firebase Console → Configuración del proyecto → Cloud Messaging → pestaña "Web
# Push certificates" → "Generate key pair" (o copiar el ya existente si el
# proyecto ya tiene uno). Sin esto, el registro del token queda deshabilitado
# de forma silenciosa (no bloquea el resto del panel, ver src/lib/firebase.ts).
VITE_FIREBASE_VAPID_KEY=tu_vapid_key_de_firebase