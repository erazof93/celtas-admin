{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,

  // Mismo modelo que el backend por defecto — cámbialo aquí si quieres probar otro.
  "model": "opencode/nemotron-3.5-lightning-free",

  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "pnpm *": "allow",
      "pnpm dlx *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow"
    },
    "skill": {
      "*": "allow"
    }
  }
}
